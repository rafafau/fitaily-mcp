{
  "name": "fitaily-mcp",
  "version": "0.3.0",
  "description": "Remote MCP server exposing the Fitaily nutrition, training and progress API as tools",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "NOTICE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fitaily",
    "nutrition",
    "fitness",
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafafau/fitaily-mcp.git"
  },
  "homepage": "https://github.com/rafafau/fitaily-mcp#readme",
  "bugs": {
    "url": "https://github.com/rafafau/fitaily-mcp/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:skills": "node scripts/validate-skills.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
