# --- Server -----------------------------------------------------------------
PORT=3091
# Set to false to silence the per-request access log.
ACCESS_LOG=true

# --- Fitaily API ------------------------------------------------------------
# Base URL of the Fitaily REST API, including the /api prefix.
FITAILY_API_URL=http://localhost:3001/api

# --- OAuth ------------------------------------------------------------------
# Public URL of this MCP endpoint. It must match the OAuth token audience
# exactly (scheme + host + path, no trailing slash).
MCP_RESOURCE_URL=https://mcp.fitaily.com/mcp
# Issuer of the OAuth authorization server (the Fitaily backend).
OAUTH_ISSUER=https://fitaily.com
# Same value as the backend JWT_SECRET — used to verify HS256 access tokens.
# Required: /mcp returns 500 when it is missing.
JWT_SECRET=change-me

# --- HTTP hardening (optional) ---------------------------------------------
# "*" or a comma-separated allowlist of browser origins.
CORS_ORIGIN=*
# Number of reverse proxies to trust (default 1, e.g. one tunnel/proxy hop).
# Set to false when the process is directly exposed to the internet.
TRUST_PROXY=1
# Maximum JSON body size for POST /mcp.
MCP_BODY_LIMIT=1mb
# Per-IP rate limit for /mcp.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
